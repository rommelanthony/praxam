# Copy this to .env.local and fill in real values.
# Never commit .env.local — it's in .gitignore.

# === Supabase (auth + database) ===
# Sign up at supabase.com, create a project, then copy these from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for server-side queries (from Supabase → Project Settings → Database → Connection String → "Transaction" mode).
# Looks like: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# === Stripe (payments) ===
# Sign up at stripe.com. Use test keys for development.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# The price ID for the £9/month Pro tier — create this in Stripe → Products
STRIPE_PRO_PRICE_ID=price_...

# === Site URL ===
# Used in Stripe checkout success/cancel redirects and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
