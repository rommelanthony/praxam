# Copy this to .env.local and fill in real values.
# Never commit .env.local — it's in .gitignore.

# === Supabase (auth + database) ===
# Sign up at supabase.com, create a project, then copy these from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for server-side queries (from Supabase → Project Settings → Database → Connection String → "Transaction" mode).
# Looks like: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# === Stripe (payments) ===
# Sandbox/test mode for local development. Production keys are set on Vercel
# Production env, not in this file.
# Source: Stripe Dashboard → Developers → API keys (with Test mode toggle ON).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Dashboard → Developers → Webhooks → signing secret for the
# /api/stripe-webhook endpoint specifically. The Supabase Stripe Sync Engine
# installs its OWN separate webhook with its own secret (managed by Supabase,
# never set here). See app/api/stripe-webhook/route.ts header comment for the
# full two-endpoint architecture explanation.
STRIPE_WEBHOOK_SECRET=
# Stripe Price ID for the Pro monthly subscription. Single Price object with
# currency_options for GBP (£6 default) / AUD (AU$12) / NZD (NZ$13) — see
# Stripe Dashboard → Products → PracXAM Pro.
STRIPE_PRO_PRICE_ID=

# === Site URL ===
# Used in Stripe checkout success/cancel redirects and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
